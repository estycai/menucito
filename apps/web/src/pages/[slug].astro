---
import { formatArs } from "@menucito/shared";
import Layout from "../layouts/Layout.astro";
import { initials } from "../lib/initials";
import { DEFAULT_API_URL, assetUrl, resolveMenu } from "../lib/menu";

// Menus change whenever the owner edits them and new restaurants appear without a rebuild.
export const prerender = false;

const apiUrl = import.meta.env.PUBLIC_API_URL || DEFAULT_API_URL;
const result = await resolveMenu(Astro.params.slug ?? "", apiUrl);

if (result.status === "redirect") return Astro.redirect(`/${result.slug}`, 301);

// Real HTTP statuses so caches and monitors behave. Error pages are never cached.
if (result.status === "not-found") {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
} else if (result.status === "unavailable") {
  Astro.response.status = 503;
  Astro.response.headers.set("Cache-Control", "no-store");
} else {
  Astro.response.headers.set("Cache-Control", "public, max-age=60");
}

const menu = result.status === "ok" ? result.menu : null;
const logo = menu ? assetUrl(apiUrl, menu.restaurant.logoUrl) : null;
const title = menu ? `${menu.restaurant.name} · Menucito` : "Menucito";
const description = menu ? `Menú de ${menu.restaurant.name}` : "Menucito";
---

{
  menu ? (
    <Layout title={title} description={description}>
      <main>
        <header class="column menu-header">
          {logo ? (
            <img class="avatar" src={logo} alt={`Logo de ${menu.restaurant.name}`} width="72" height="72" />
          ) : (
            <span class="avatar avatar-initials" aria-hidden="true">
              {initials(menu.restaurant.name)}
            </span>
          )}
          <h1 class="menu-title">{menu.restaurant.name}</h1>
        </header>

        {menu.categories.length === 0 ? (
          <p class="column empty-menu">Este menú todavía no tiene productos.</p>
        ) : (
          <>
            <nav class="category-nav" aria-label="Categorías">
              <ul>
                {menu.categories.map((category, index) => (
                  <li>
                    <a class="chip" href={`#categoria-${index + 1}`}>
                      {category.name}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            {menu.categories.map((category, index) => (
              <section class="column category" aria-labelledby={`categoria-${index + 1}`}>
                <h2 class="category-title" id={`categoria-${index + 1}`}>
                  {category.name}
                </h2>
                <ul class="products">
                  {category.products.map((product) => {
                    const photo = assetUrl(apiUrl, product.imageUrl);
                    return (
                      <li class:list={["product", { "is-sold-out": !product.available }]}>
                        {photo && (
                          <img
                            class="product-photo"
                            src={photo}
                            alt=""
                            width="96"
                            height="96"
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                        <div class="product-body">
                          <h3 class="product-name">{product.name}</h3>
                          {product.description && <p class="product-description">{product.description}</p>}
                          <div class="product-footer">
                            <span class="product-price">{formatArs(product.priceCents)}</span>
                            {!product.available && <span class="sold-out-badge">Agotado</span>}
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))}
            <div class="menu-footer-space"></div>
          </>
        )}
      </main>
    </Layout>
  ) : result.status === "not-found" ? (
    <Layout title="No encontramos este menú · Menucito" description="No encontramos este menú">
      <main class="centered">
        <h1 class="message-title">No encontramos este menú</h1>
        <p class="message-text">Revisá que el link esté bien escrito.</p>
        <a class="button-link" href="/">
          Ir al inicio
        </a>
      </main>
    </Layout>
  ) : (
    <Layout title="Menú no disponible · Menucito" description="No pudimos cargar el menú">
      <main class="centered">
        <h1 class="message-title">Algo salió mal</h1>
        <p class="message-text">No pudimos cargar el menú. Probá de nuevo en un momento.</p>
      </main>
    </Layout>
  )
}
