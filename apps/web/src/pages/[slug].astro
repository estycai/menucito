---
import { formatArs } from "@menucito/shared";
import { AddControl } from "../components/AddControl";
import { CartBar } from "../components/CartBar";
import MenuProblem from "../components/MenuProblem.astro";
import Layout from "../layouts/Layout.astro";
import { toCatalog, toCatalogProduct } from "../lib/catalog";
import { initials } from "../lib/initials";
import { DEFAULT_API_URL, assetUrl, resolveMenu, responseFor } from "../lib/menu";

// Menus change whenever the owner edits them and new restaurants appear without a rebuild.
export const prerender = false;

const apiUrl = import.meta.env.PUBLIC_API_URL || DEFAULT_API_URL;
const result = await resolveMenu(Astro.params.slug ?? "", apiUrl);

if (result.status === "redirect") return Astro.redirect(`/${result.slug}`, 301);

// Real HTTP statuses so caches and monitors behave. Error pages are never cached.
const { status, cacheControl } = responseFor(result);
Astro.response.status = status;
Astro.response.headers.set("Cache-Control", cacheControl);

const menu = result.status === "ok" ? result.menu : null;
// The islands price and reconcile the cart with this data, embedded by the server render.
const catalog = menu ? toCatalog(menu) : [];
const logo = menu ? assetUrl(apiUrl, menu.restaurant.logoUrl) : null;
const cover = menu ? assetUrl(apiUrl, menu.restaurant.coverUrl) : null;
const title = menu ? `${menu.restaurant.name} · Menucito` : "Menucito";
const description = menu ? menu.restaurant.description || `Menú de ${menu.restaurant.name}` : "Menucito";
const featured = menu?.featured ?? null;
// With nothing but the featured row there is nothing to navigate between.
const hasCategories = (menu?.categories.length ?? 0) > 0;
// A scrollable region needs to be focusable, unless a button inside already gives the keyboard a way in.
const featuredRowProps = featured?.products.some((product) => product.available)
  ? {}
  : { tabindex: 0, role: "region" as const, "aria-label": featured?.name };
---

{
  menu ? (
    <Layout title={title} description={description} colors={menu.restaurant.colors}>
      <script is:inline slot="head">
        document.documentElement.classList.add("js");
      </script>
      <main>
        {!menu.restaurant.acceptingOrders && (
          <aside class="column pause-banner" role="status">
            <p>Este local no está recibiendo pedidos por ahora. Podés ver el menú.</p>
          </aside>
        )}
        <header>
          <div class="cover">
            {cover && (
              <img class="cover-image" src={cover} alt="" width="1200" height="400" fetchpriority="high" decoding="async" />
            )}
          </div>
          <div class="column menu-identity">
            {logo ? (
              <img class="avatar" src={logo} alt={`Logo de ${menu.restaurant.name}`} width="72" height="72" />
            ) : (
              <span class="avatar avatar-initials" aria-hidden="true">
                {initials(menu.restaurant.name)}
              </span>
            )}
            <h1 class="menu-title">{menu.restaurant.name}</h1>
            {menu.restaurant.description && <p class="menu-description">{menu.restaurant.description}</p>}
          </div>
        </header>

        {catalog.length === 0 ? (
          <p class="column empty-menu">Este menú todavía no tiene productos.</p>
        ) : (
          <>
            <noscript>
              <p class="column noscript-note">Para agregar productos al pedido necesitás activar JavaScript.</p>
            </noscript>

            {featured && (
              <section class="featured" aria-labelledby="destacados">
                <div class="column featured-heading">
                  <span class="featured-star" aria-hidden="true">
                    ★
                  </span>
                  <h2 class="category-title" id="destacados">
                    {featured.name}
                  </h2>
                </div>
                <ul class="featured-row" {...featuredRowProps}>
                  {featured.products.map((product) => {
                    const photo = assetUrl(apiUrl, product.imageUrl);
                    return (
                      <li class:list={["feature-card", { "is-sold-out": !product.available }]}>
                        {photo ? (
                          <img
                            class="feature-photo"
                            src={photo}
                            alt=""
                            width="228"
                            height="128"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <div class="feature-photo" aria-hidden="true" />
                        )}
                        <div class="feature-body">
                          <h3 class="product-name">{product.name}</h3>
                          {product.description && <p class="product-description">{product.description}</p>}
                          <div class="product-footer">
                            <span class="product-price">{formatArs(product.priceCents)}</span>
                            {!product.available && <span class="sold-out-badge">Agotado</span>}
                            {product.available && (
                              <AddControl client:load slug={menu.restaurant.slug} product={toCatalogProduct(product)} />
                            )}
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </section>
            )}

            {hasCategories && (
              <>
                <div class="nav-sentinel" data-nav-sentinel aria-hidden="true" />
                <nav class="category-nav" aria-label="Categorías" data-category-nav>
                  <ul>
                    {menu.categories.map((category, index) => (
                      <li>
                        <a
                          class="chip"
                          href={`#categoria-${index + 1}`}
                          aria-current={index === 0 ? "true" : undefined}
                        >
                          {category.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
                {/* Visual repeat of the h1, shown while the category bar is stuck. Only exists with JavaScript. */}
                <div class="identity-bar" aria-hidden="true">
                  <div class="identity-bar-inner">
                    {logo ? (
                      <img class="identity-logo" src={logo} alt="" width="32" height="32" decoding="async" />
                    ) : (
                      <span class="identity-logo identity-initials">{initials(menu.restaurant.name)}</span>
                    )}
                    <span class="identity-name">{menu.restaurant.name}</span>
                  </div>
                </div>
              </>
            )}

            {menu.categories.map((category, index) => (
              <section class="column category" aria-labelledby={`categoria-${index + 1}`}>
                <h2 class="category-title" id={`categoria-${index + 1}`}>
                  {category.name}
                </h2>
                <ul class="products">
                  {category.products.map((product) => {
                    const photo = assetUrl(apiUrl, product.imageUrl);
                    return (
                      <li class:list={["product", { "is-sold-out": !product.available }]}>
                        {photo && (
                          <img
                            class="product-photo"
                            src={photo}
                            alt=""
                            width="96"
                            height="96"
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                        <div class="product-body">
                          <h3 class="product-name">{product.name}</h3>
                          {product.description && <p class="product-description">{product.description}</p>}
                          <div class="product-footer">
                            <span class="product-price">{formatArs(product.priceCents)}</span>
                            {!product.available && <span class="sold-out-badge">Agotado</span>}
                            {product.available && (
                              <AddControl client:load slug={menu.restaurant.slug} product={toCatalogProduct(product)} />
                            )}
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))}
            <div class="menu-footer-space"></div>
            <CartBar client:load slug={menu.restaurant.slug} products={catalog} />
          </>
        )}
      </main>
    </Layout>
  ) : (
    <MenuProblem kind={result.status === "not-found" ? "not-found" : "unavailable"} />
  )
}

<script>
  import "../scripts/menu-nav";
</script>
